# Copy to .env and replace only with local values. .env is ignored by Git.
# Bind sources are provider-specific. On Windows, Docker/WSL and the external
# Podman Compose provider can require different path forms; see
# docs/user-guide/INSTALLATION.md.
FOLIOTONE_IMAGE=foliotone:local
FOLIOTONE_DATA_DIR=./data
FOLIOTONE_EBOOKS_DIR=./media/ebooks
